#--------------------------------------------------------------------
# Levit API — copie para .env e preencha:  cp .env.example .env
# O .env nunca vai para o git (tem senhas e chaves).
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# Banco de dados (PostgreSQL)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = levit
database.default.username =
database.default.password =
database.default.DBDriver = Postgre
database.default.charset  = utf8
database.default.port     = 5432

#--------------------------------------------------------------------
# Autenticação — use um valor longo e aleatório
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#--------------------------------------------------------------------
JWT_SECRET_KEY =

#--------------------------------------------------------------------
# Armazenamento de arquivos (Backblaze B2, compatível com S3)
# Sem isto, a tabela de arquivos e os currículos não funcionam.
# B2_ENDPOINT vai sem https://  (ex.: s3.us-east-005.backblazeb2.com)
#--------------------------------------------------------------------
B2_ENDPOINT =
B2_REGION =
B2_BUCKET =
B2_KEY_ID =
B2_APPLICATION_KEY =

#--------------------------------------------------------------------
# E-mail (Brevo)
#--------------------------------------------------------------------
BREVO_API_KEY =
BREVO_REMETENTE_EMAIL =
BREVO_REMETENTE_NOME = Levit

#--------------------------------------------------------------------
# Opcionais (o valor abaixo é o padrão quando não definidos)
#--------------------------------------------------------------------
# EMAIL_PROVIDER = brevo
# FRONTEND_URL = http://localhost:5173
# FUSO_HORARIO = America/Sao_Paulo
# RESUMO_DIARIO_EMAIL = true
