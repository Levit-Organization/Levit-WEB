#--------------------------------------------------------------------
# Levit - Environment Configuration Example
#
# Copie este arquivo para ".env" e preencha os valores conforme
# o ambiente em que a aplicação será executada.
#
# NUNCA versione o arquivo ".env" com credenciais reais.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development


#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = http://localhost:8080/

# Use "true" somente quando a aplicação estiver sendo executada
# exclusivamente com HTTPS.
app.forceGlobalSecureRequests = false

# Content Security Policy
app.CSPEnabled = false


#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.DSN =
database.default.hostname = localhost
database.default.database =
database.default.username =
database.default.password =
database.default.DBDriver =
database.default.port =
database.default.charset = utf8mb4

# Prefixo das tabelas, caso utilizado.
# database.default.DBPrefix =


#--------------------------------------------------------------------
# JWT
#--------------------------------------------------------------------

# Gere uma chave forte e exclusiva para cada ambiente.
# NUNCA utilize uma chave real no ".env.example".
JWT_SECRET_KEY =


#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# Chave utilizada pelo CodeIgniter para criptografia.
# Gere uma chave forte e mantenha-a somente no ".env".
encryption.key =


#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = CodeIgniter\Session\Handlers\FileHandler
# session.savePath =


#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Níveis:
# 0 = Emergency
# 1 = Alert
# 2 = Critical
# 3 = Error
# 4 = Warning
# 5 = Notice
# 6 = Info
# 7 = Debug
#
# logger.threshold = 4


#--------------------------------------------------------------------
# BLACKBLAZE B2
#--------------------------------------------------------------------

B2_ENDPOINT =
B2_REGION =
B2_BUCKET =
B2_KEY_ID =
B2_APPLICATION_KEY =


#--------------------------------------------------------------------
# BREVO
#--------------------------------------------------------------------

BREVO_API_KEY =
BREVO_REMETENTE_EMAIL =
BREVO_REMETENTE_NOME =

# Provedor utilizado para envio de e-mails.
EMAIL_PROVIDER = brevo